{
  "name": "fastool",
  "version": "1.0.0",
  "description": "A compact, modern JavaScript utility library with zero runtime dependencies, written in TypeScript, supporting ESM / CJS / UMD.",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "unpkg": "dist/index.umd.min.js",
  "jsdelivr": "dist/index.umd.min.js",
  "types": "dist/index.d.ts",
  "jsname": "fastool",
  "packageManager": "pnpm@11.16.0",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "default": "./dist/index.mjs"
    },
    "./plugins": {
      "types": "./dist/plugins.d.ts",
      "import": "./dist/plugins.mjs",
      "require": "./dist/plugins.cjs",
      "default": "./dist/plugins.mjs"
    },
    "./polyfill": {
      "types": "./dist/polyfill.d.ts",
      "import": "./dist/polyfill.mjs",
      "require": "./dist/polyfill.cjs",
      "default": "./dist/polyfill.mjs"
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "plugins": [
        "dist/plugins.d.ts"
      ],
      "polyfill": [
        "dist/polyfill.d.ts"
      ]
    }
  },
  "scripts": {
    "dev": "rollup -c -w",
    "build": "rimraf dist && rollup -c",
    "typecheck": "tsc --noEmit",
    "test": "pnpm run build && node --test \"test/**/*.test.mjs\"",
    "prepublishOnly": "pnpm run build",
    "docs": "vitepress dev docs",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:serve": "vitepress serve docs",
    "docs:preview": "vitepress build docs && vitepress preview docs"
  },
  "homepage": "https://tobe-fe-dalao.github.io/fastool/",
  "bugs": "https://github.com/tobe-fe-dalao/fastool/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tobe-fe-dalao/fastool.git"
  },
  "author": "BlindMonk",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "utils",
    "utilities",
    "toolkit",
    "tools",
    "javascript",
    "typescript",
    "zero-dependency",
    "tree-shakeable",
    "esm",
    "cjs",
    "umd",
    "browser",
    "frontend",
    "helper",
    "fastool"
  ],
  "devDependencies": {
    "@rollup/plugin-commonjs": "^28.0.3",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.1",
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-typescript": "^12.1.4",
    "@types/node": "^22.15.3",
    "rimraf": "^6.0.1",
    "rollup": "^4.41.1",
    "rollup-plugin-dts": "^6.2.1",
    "tslib": "^2.8.1",
    "typescript": "^5.8.3",
    "vitepress": "^1.6.0"
  }
}
